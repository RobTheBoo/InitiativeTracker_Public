{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/RobTheBoo/InitiativeTracker_Public/main/catalog/v1/package.schema.json",
  "title": "InitiativeTracker downloadable package",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "name",
    "ruleset",
    "items"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "ruleset": {
      "type": "object",
      "required": [
        "id",
        "edition"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "edition": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "items": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "required": [
          "id",
          "category",
          "name",
          "description",
          "rulesData"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "rulesData": {
            "type": "object"
          }
        },
        "additionalProperties": true
      }
    },
    "distribution": {
      "$ref": "#/$defs/distribution"
    }
  },
  "additionalProperties": true,
  "$defs": {
    "license": {
      "type": "object",
      "required": [
        "id",
        "name",
        "text"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "notice": {
      "type": "object",
      "required": [
        "id",
        "type",
        "text"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "section15",
            "copyright",
            "attribution",
            "other"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": [
        "id",
        "name",
        "url",
        "revision",
        "itemIds"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "itemIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "distribution": {
      "type": "object",
      "required": [
        "redistributionStatus",
        "licenses",
        "notices",
        "sources"
      ],
      "properties": {
        "redistributionStatus": {
          "const": "verified"
        },
        "licenses": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/license"
          }
        },
        "notices": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/notice"
          }
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/source"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
